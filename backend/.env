# Environment variables
DATABASE_URL=sqlite:///./poisonsense.db
SECRET_KEY=poisonsense-ai-secret-key-change-in-production-min-32-chars
DEBUG=True
ML_MODEL_PATH=app/ml/models
ML_DATA_PATH=app/ml/data

# ============ EMAIL SETTINGS (SMTP) ============
# IMPORTANT: To enable email verification, configure these settings:
# For Gmail:
# 1. Enable 2-Step Verification in your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate a new App Password for "Mail"
# 4. Use that 16-character password below (no spaces)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=PoisonSense AI

# OTP Settings
OTP_EXPIRE_MINUTES=10
