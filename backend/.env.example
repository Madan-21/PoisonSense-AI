# ── LLM Provider ─────────────────────────────────────────────────────
# Options: "groq" | "openai" | "ollama"
LLM_PROVIDER=groq

# ── Groq (recommended - free & fast) ────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI (alternative) ────────────────────────────────────────────
# OPENAI_API_KEY=your-openai-key
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Ollama (local, free) ────────────────────────────────────────────
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

# ── Embedding Provider ──────────────────────────────────────────────
# Options: "local" (sentence-transformers, free) | "openai"
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Retrieval Settings ──────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=200
TOP_K=8
RELEVANCE_THRESHOLD=0.25

# ── App Settings ────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
# DATABASE_URL is auto-resolved to an absolute path — no need to set it here
# DATABASE_URL=sqlite:///./poisonsense.db

# ── Email / SMTP (Gmail) ────────────────────────────────────────────
# To use Gmail: enable 2FA → create an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
