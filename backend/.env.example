# PoisonSense AI Backend Configuration
# Copy this file to .env and fill in your values

# ============ APP SETTINGS ============
APP_NAME="PoisonSense AI"
APP_VERSION="1.0.0"
DEBUG=True

# ============ DATABASE ============
DATABASE_URL="sqlite:///./poisonsense.db"

# ============ JWT AUTHENTICATION ============
SECRET_KEY="your-super-secret-key-change-this-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ EMAIL SETTINGS (SMTP) ============
# For Gmail:
# 1. Go to Google Account > Security > 2-Step Verification (enable it)
# 2. Go to App passwords > Generate a new app password
# 3. Use that 16-character password below

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
EMAIL_FROM_NAME="PoisonSense AI"

# OTP Settings
OTP_EXPIRE_MINUTES=10

# ============ CORS ============
# Add your frontend URL(s) separated by commas
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ============ EXTERNAL APIs (Optional) ============
GOOGLE_MAPS_API_KEY=""
